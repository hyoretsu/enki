{
	"compilerOptions": {
		"baseUrl": ".",
		"lib": ["ESNext"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"paths": {
			"~/*": ["./*"]
		},
		"resolveJsonModule": true,
		"rootDir": "../",
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["bun-types"]
	}
}
