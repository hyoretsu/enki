			"biome check --apply"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/node": "latest",
		"bun-types": "latest",
		"lint-staged": "^15.2.10",
		"typescript": "latest"
	},
	"overrides": {
		"ajv": "^8.17.1"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@enki/infra"
	]
}
