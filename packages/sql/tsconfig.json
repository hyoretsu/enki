{
	"compilerOptions": {
		"lib": ["ESNext"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["bun-types"]
	},
	"exclude": ["node_modules"],
	"include": ["src/**/*.ts"]
}
