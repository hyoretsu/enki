{
	"compilerOptions": {
		"lib": ["ESNext"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["bun-types"]
	},
	"exclude": ["node_modules", "dist"],
	"include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
