{
	"name": "backend",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build --compile --target=bun-linux-amd64 --outfile=dist/server ./src/main.ts",
		"check-types": "tsc --noEmit",
		"dev": "bun --watch src/main.ts",
		"export": "bun ./src/generateOpenApi.ts",
		"start": "NODE_ENV=production bun ./src/main.ts",
		"test": "bun scripts/test.ts",
		"test:e2e": "bun run test e2e",
		"test:unit": "bun run test unit"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.1.0",
		"@elysiajs/swagger": "^1.1.1",
		"@googleapis/youtube": "^20.0.0",
		"@hyoretsu/utils": "^1.15.0",
		"better-auth": "^1.6.15",
		"elysia": "^1.1.26",
		"http-status-codes": "^2.3.0",
		"iso8601-duration": "^2.1.2",
		"pg": "^8.12.0",
		"sql": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"@types/pg": "^8.11.6",
		"typescript": "latest"
	}
}
